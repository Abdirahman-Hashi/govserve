# GovServe environment variables. Copy to .env for local development.
# Values below are dev-only defaults matching infra/docker-compose.yml. Never commit real secrets.

# --- Runtime ---
# development | test | production
NODE_ENV=development
# Version reported by /health and /ready (CI sets the commit SHA; defaults to "dev")
APP_VERSION=dev
# Port the API listens on
API_PORT=3000
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Requests per minute per IP (global default rate limit)
RATE_LIMIT_PER_MINUTE=100

# --- PostgreSQL (compose maps it to host port 5433) ---
DATABASE_URL=postgresql://govserve:govserve_dev@localhost:5433/govserve?schema=public

# --- Redis (BullMQ, rate limiting, token denylist) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (RustFS locally, ADR-0007) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=govserve-documents
S3_ACCESS_KEY_ID=govserve
S3_SECRET_ACCESS_KEY=govserve_dev_secret
# true for local S3 stores (path-style URLs)
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally; UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="GovServe <no-reply@govserve.local>"

# --- Virus scan (ClamAV, Phase 4; start compose with --profile scan) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Web (Vite) ---
# Where the Vite dev server proxies /api, /health and /ready
VITE_API_PROXY_TARGET=http://localhost:3000
