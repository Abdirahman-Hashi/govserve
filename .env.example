# GovServe environment variables. Copy to .env for local development.
# Values below are dev-only defaults matching infra/docker-compose.yml. Never commit real secrets.

# --- Runtime ---
# development | test | production
NODE_ENV=development
# Version reported by /health and /ready (CI sets the commit SHA; defaults to "dev")
APP_VERSION=dev
# Port the API listens on
API_PORT=3000
# Public base URL of this API (mock card gateway webhook target, links in PDFs)
PUBLIC_API_URL=http://localhost:3000
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Requests per minute per IP (global default; sign-in/code endpoints allow 10, session refresh 60)
RATE_LIMIT_PER_MINUTE=100
# Only automated tests set this to false
RATE_LIMIT_ENABLED=true

# --- Web app ---
# Public URL of the web app: links in emails and receipts, Origin check on cookie endpoints
WEB_ORIGIN=http://localhost:5173
# Refresh/device cookies are Secure by default; browsers accept Secure cookies on http://localhost
COOKIE_SECURE=true

# --- Secrets (generate your own; never reuse these placeholders) ---
# HS256 signing key for access tokens, at least 32 characters: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
# PII encryption key ring, "keyId:base64(32 bytes)" comma-separated; the first key encrypts.
# Generate: echo "k1:$(openssl rand -base64 32)"
PII_KEYS=k1:REPLACE_WITH_openssl_rand_base64_32_OUTPUT_=
# HMAC key for blind indexes and one-time-code hashes (base64, >= 32 bytes): openssl rand -base64 32
BLIND_INDEX_KEY=REPLACE_WITH_openssl_rand_base64_32_OUTPUT_=
# Ed25519 keys that sign receipts and certificates (ADR-0006): "keyId:base64(PKCS#8 DER)", comma-separated.
# The first key signs; keep retired keys listed so old receipts still verify.
# Generate: echo "k1:$(openssl genpkey -algorithm ed25519 -outform DER | base64)"
SIGNING_KEYS=k1:REPLACE_WITH_BASE64_PKCS8_DER_ED25519_KEY

# --- Card payments ---
# Only "mock" exists until a gateway is chosen (open item O-7); refused in production.
CARD_GATEWAY=mock
# Shared secret for gateway webhook HMAC signatures (>= 32 characters): openssl rand -base64 48
CARD_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-base64-48

# --- PostgreSQL (compose maps it to host port 5433) ---
DATABASE_URL=postgresql://govserve:govserve_dev@localhost:5433/govserve?schema=public

# --- Redis (BullMQ jobs, rate limiting, session revocation) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (RustFS locally, ADR-0007) ---
S3_ENDPOINT=http://localhost:9000
# Host browsers use for pre-signed upload/download URLs, if different from S3_ENDPOINT (optional)
# S3_PUBLIC_ENDPOINT=https://files.example.gov.so
S3_REGION=us-east-1
S3_BUCKET=govserve-documents
S3_ACCESS_KEY_ID=govserve
S3_SECRET_ACCESS_KEY=govserve_dev_secret
# true for local S3 stores (path-style URLs)
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit locally; UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="GovServe <no-reply@govserve.local>"

# --- Virus scanning (FR-035) ---
# clamav (required in production) or noop (local development without the scan profile)
VIRUS_SCANNER=noop
# Start ClamAV with: docker compose -f infra/docker-compose.yml --profile scan up -d
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Web (Vite) ---
# Where the Vite dev server proxies /api, /health and /ready
VITE_API_PROXY_TARGET=http://localhost:3000

# Playwright officer flow (dev/test only): password for the e2e staff accounts created by `pnpm --filter api e2e:staff`.
# Leave empty to skip the officer e2e test.
E2E_STAFF_PASSWORD=

# Notification delivery (FR-102): attempts before dead-letter, first retry delay (ms), outbox poll interval (ms).
NOTIFY_ATTEMPTS=5
NOTIFY_BACKOFF_MS=30000
OUTBOX_POLL_MS=5000

# Search CSV export row cap (FR-112, maximum 50000).
SEARCH_EXPORT_CAP=50000

# Runtime connection as the restricted application role (member of govserve_app_rw, ADR-0010).
# DATABASE_URL stays the owner and is used for migrations. In production these must differ.
# Dev: create the role with `pnpm --filter api db:app-role`.
DATABASE_APP_URL=postgresql://govserve_app:govserve_app_dev@localhost:5433/govserve

# --- Phase 11: deployment (all optional locally; see docs/RUNBOOK.md for staging/production) ---
# local | staging | production. Production builds (NODE_ENV=production) must say staging or production.
# DEPLOY_ENV=local
# mock (local, staging) | disabled (production until the card gateway is chosen, O-7)
# CARD_GATEWAY=mock
# SMTP authentication and TLS for a real relay (Mailpit needs none of these).
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# Bearer token Prometheus uses for /metrics; required when NODE_ENV=production.
# METRICS_TOKEN=
# Any variable can instead be read from a file: set X_FILE=/run/secrets/x (the deployed stack does this).
