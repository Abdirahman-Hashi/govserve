{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "prisma generate && eslint src test scripts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest",
    "test:int": "prisma generate && jest --config jest.int.config.ts --runInBand",
    "openapi:lock": "prisma generate >/dev/null && ts-node --swc scripts/openapi-lock.ts",
    "openapi:export": "prisma generate && ts-node --swc scripts/export-openapi.ts",
    "db:app-role": "ts-node --swc scripts/db-app-role.ts",
    "e2e:staff": "ts-node --swc src/cli/e2e-staff.ts",
    "admin:bootstrap": "prisma generate >/dev/null && ts-node --swc src/cli/bootstrap-admin.ts",
    "permissions:matrix": "prisma generate >/dev/null && ts-node --swc scripts/permissions-matrix.ts",
    "db:seed": "prisma generate >/dev/null && ts-node --swc prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.7",
    "fast-check": "4.10.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/s3-request-presigner": "3.1142.0",
    "@govserve/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.13",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  }
}
