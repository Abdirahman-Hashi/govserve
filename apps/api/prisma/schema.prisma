// GovServe database schema. Entities are added phase by phase per docs/DATA_MODEL.md.
// Partial unique indexes, check constraints, triggers and grants live in SQL migrations (ADR-0002).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─── Identity and access (DATA_MODEL §1) ────────────────────────────────────

enum Role {
  CITIZEN
  OFFICER
  SUPERVISOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum NationalIdType {
  NATIONAL_ID
  PASSPORT
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  STAFF_DEVICE
  CHANGE_EMAIL
}

enum ActorType {
  USER
  SYSTEM
  PUBLIC
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users        User[]
  invitations  StaffInvitation[]
  services     Service[]
  applications Application[]

  @@map("department")
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.Citext
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  passwordHash     String?
  fullName         String
  phoneEnc         Bytes?
  phoneBidx        String?
  role             Role
  departmentId     String?    @db.Uuid
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  failedLoginAt    DateTime?  @db.Timestamptz(3)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  version          Int        @default(0)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  department             Department?             @relation(fields: [departmentId], references: [id])
  citizenProfile         CitizenProfile?
  refreshTokens          RefreshToken[]
  otpCodes               OtpCode[]
  trustedDevices         TrustedDevice[]
  invitationsSent        StaffInvitation[]       @relation("InvitedBy")
  applications           Application[]           @relation("Applicant")
  assigned               Application[]           @relation("Assignee")
  documents              Document[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@index([role, departmentId])
  @@index([phoneBidx])
  @@index([emailVerifiedAt, createdAt])
  @@map("user")
}

model CitizenProfile {
  userId         String          @id @db.Uuid
  nationalIdType NationalIdType?
  nationalIdEnc  Bytes?
  nationalIdBidx String?
  dateOfBirthEnc Bytes?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // unique(nationalIdBidx) WHERE NOT NULL is a partial index in the migration SQL.
  @@map("citizen_profile")
}

model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  familyId      String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  rotatedAt     DateTime? @db.Timestamptz(3)
  // Set when a just-rotated token was presented once more within the grace period (two tabs).
  graceUsedAt   DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_token")
}

model OtpCode {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String?    @db.Uuid
  email       String     @db.Citext
  purpose     OtpPurpose
  codeHash    String
  // For STAFF_DEVICE: hash of the device the challenge was issued to; for CHANGE_EMAIL: unused.
  contextHash String?
  expiresAt   DateTime   @db.Timestamptz(3)
  attempts    Int        @default(0)
  consumedAt  DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, consumedAt])
  @@map("otp_code")
}

model StaffInvitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @db.Citext
  fullName     String
  role         Role
  departmentId String?   @db.Uuid
  tokenHash    String    @unique
  invitedById  String?   @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  department Department? @relation(fields: [departmentId], references: [id])
  invitedBy  User?       @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@map("staff_invitation")
}

model TrustedDevice {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  deviceIdHash String
  lastSeenAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdHash])
  @@map("trusted_device")
}

// ─── Audit (DATA_MODEL §6). Hash chain and append-only grants: Phase 10. ────

model AuditLog {
  id           BigInt    @id @default(autoincrement())
  occurredAt   DateTime  @default(now()) @db.Timestamptz(3)
  actorId      String?   @db.Uuid
  actorRole    Role?
  actorType    ActorType
  action       String
  entityType   String
  entityId     String
  departmentId String?   @db.Uuid
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  requestId    String?
  prevHash     Bytes?
  hash         Bytes?
  /// Position in the hash chain: assigned by the insert trigger in commit order (ADR-0010).
  chainSeq     BigInt?   @unique

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([departmentId, occurredAt])
  @@index([action])
  @@map("audit_log")
}

/// Last verified point of the audit chain, so removing rows from the end is detected too.
model AuditCheckpoint {
  id         BigInt   @id @default(autoincrement())
  chainSeq   BigInt
  hash       Bytes
  verifiedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("audit_checkpoint")
}

// ─── Catalogue (DATA_MODEL §2) ──────────────────────────────────────────────

enum InPersonStep {
  NONE
  FINGERPRINTS
  APPEARANCE
}

enum ApprovalMode {
  SINGLE
  SUPERVISOR_SECOND
  SUPERVISOR_ON_RECORD_FOUND
}

enum SubjectMode {
  SELF
  SELF_OR_CHILD
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ReasonCodeKind {
  REJECT
  PAYMENT_REJECT
  REVOKE
  REFUND_DECLINE
}

model Service {
  id                String       @id @default(uuid(7)) @db.Uuid
  code              String       @unique
  name              String
  description       String
  departmentId      String       @db.Uuid
  active            Boolean      @default(true)
  slaWorkingDays    Int
  inPersonStep      InPersonStep
  approvalMode      ApprovalMode
  validityMonths    Int?
  certificatePrefix String       @unique
  subjectMode       SubjectMode
  version           Int          @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  department   Department       @relation(fields: [departmentId], references: [id])
  versions     ServiceVersion[]
  applications Application[]
  certificates Certificate[]

  @@map("service")
}

/// Immutable once PUBLISHED (FR-021); only DRAFT rows are ever updated.
model ServiceVersion {
  id                String        @id @default(uuid(7)) @db.Uuid
  serviceId         String        @db.Uuid
  versionNo         Int
  status            VersionStatus @default(DRAFT)
  formSchema        Json
  uiSchema          Json
  requiredDocuments Json
  feeBaseCents      BigInt
  feePerCopyCents   BigInt
  feeIsTest         Boolean       @default(true)
  publishedAt       DateTime?     @db.Timestamptz(3)
  publishedById     String?       @db.Uuid
  retiredAt         DateTime?     @db.Timestamptz(3)
  createdById       String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  service      Service       @relation(fields: [serviceId], references: [id])
  applications Application[]

  @@unique([serviceId, versionNo])
  @@index([serviceId, status])
  @@map("service_version")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("setting")
}

model Holiday {
  date      DateTime @id @db.Date
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("holiday")
}

model ReasonCode {
  id        String         @id @default(uuid(7)) @db.Uuid
  kind      ReasonCodeKind
  code      String
  label     String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([kind, code])
  @@map("reason_code")
}

// ─── Applications (DATA_MODEL §3, STATE_MACHINES §1) ────────────────────────

enum ApplicationStatus {
  DRAFT
  AWAITING_PAYMENT
  QUEUED
  IN_REVIEW
  CORRECTION_REQUESTED
  AWAITING_APPOINTMENT
  AWAITING_SUPERVISOR
  ISSUED
  REJECTED
  REFERRED
  WITHDRAWN
  ABANDONED
}

enum ApplicationKind {
  STANDARD
  DUPLICATE
}

enum SubjectType {
  SELF
  CHILD
}

enum Relationship {
  SELF
  MOTHER
  FATHER
  GUARDIAN
}

enum ReviewOutcome {
  NO_RECORD
  RECORD_FOUND
}

enum DocumentStatus {
  PENDING_UPLOAD
  QUARANTINED
  CLEAN
  INFECTED
  REJECTED
}

enum CorrectionItemKind {
  FIELD
  DOCUMENT
}

/// Status changes only through ApplicationStateService (backend rules).
model Application {
  id                  String            @id @default(uuid(7)) @db.Uuid
  referenceNo         String?           @unique
  kind                ApplicationKind   @default(STANDARD)
  applicantId         String            @db.Uuid
  serviceId           String            @db.Uuid
  serviceVersionId    String            @db.Uuid
  departmentId        String            @db.Uuid
  subjectType         SubjectType?
  /// SELF: the applicant's id; CHILD: keyed hash of name + DOB + mother's name (set on submit).
  subjectKey          String?
  relationship        Relationship?
  extraCopies         Int               @default(0)
  sourceCertificateId String?           @db.Uuid
  status              ApplicationStatus @default(DRAFT)
  assigneeId          String?           @db.Uuid
  claimExpiresAt      DateTime?         @db.Timestamptz(3)
  correctionRound     Int               @default(0)
  correctionDueAt     DateTime?         @db.Timestamptz(3)
  slaDueAt            DateTime?         @db.Timestamptz(3)
  slaPausedAt         DateTime?         @db.Timestamptz(3)
  slaPausedTotalMs    BigInt            @default(0)
  /// Set once when the SLA is first missed (one breach notice per application).
  slaBreachedAt       DateTime?         @db.Timestamptz(3)
  reviewOutcome       ReviewOutcome?
  chargebackFlag      Boolean           @default(false)
  submittedAt         DateTime?         @db.Timestamptz(3)
  queuedAt            DateTime?         @db.Timestamptz(3)
  decidedAt           DateTime?         @db.Timestamptz(3)
  version             Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  applicant      User                       @relation("Applicant", fields: [applicantId], references: [id])
  assignee       User?                      @relation("Assignee", fields: [assigneeId], references: [id])
  service        Service                    @relation(fields: [serviceId], references: [id])
  serviceVersion ServiceVersion             @relation(fields: [serviceVersionId], references: [id])
  department     Department                 @relation(fields: [departmentId], references: [id])
  data           ApplicationData?
  history        ApplicationStatusHistory[]
  documents      Document[]
  corrections    CorrectionRequest[]
  feeAssessment  FeeAssessment?
  payments       Payment[]
  appointments   Appointment[]
  decisions      ReviewDecision[]
  certificates   Certificate[]

  // Partial unique index for FR-031 is in the migration SQL.
  @@index([departmentId, status, slaDueAt])
  @@index([assigneeId, status])
  // Keyset pagination (FR-110/FR-111): (createdAt DESC, id DESC) within the caller's scope.
  @@index([applicantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([departmentId, createdAt(sort: Desc), id(sort: Desc)])
  // Partial reference search (Phase 08, created in the search migration).
  @@index([referenceNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "application_referenceNo_trgm_idx")
  @@index([status, updatedAt])
  @@map("application")
}

/// Form answers. Non-PII values in `data`; fields marked x-pii are one encrypted JSON blob (NFR-002).
model ApplicationData {
  applicationId         String   @id @db.Uuid
  data                  Json     @default("{}")
  piiEnc                Bytes?
  subjectFullName       String?
  subjectNationalIdBidx String?
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([subjectNationalIdBidx])
  @@map("application_data")
}

/// Append-only.
model ApplicationStatusHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?            @db.Uuid
  actorType     ActorType
  note          String?
  at            DateTime           @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@map("application_status_history")
}

model Document {
  id             String         @id @default(uuid(7)) @db.Uuid
  applicationId  String?        @db.Uuid
  paymentId      String?        @db.Uuid
  ownerId        String         @db.Uuid
  docType        String
  storageKey     String         @unique
  originalName   String
  mime           String
  sizeBytes      Int
  sha256         String
  status         DocumentStatus @default(PENDING_UPLOAD)
  statusReason   String?
  supersededById String?        @db.Uuid
  uploadedAt     DateTime?      @db.Timestamptz(3)
  scannedAt      DateTime?      @db.Timestamptz(3)
  purgedAt       DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  owner       User         @relation(fields: [ownerId], references: [id])

  @@index([applicationId, docType])
  @@index([status, createdAt])
  @@map("document")
}

model CorrectionRequest {
  id            String    @id @default(uuid(7)) @db.Uuid
  applicationId String    @db.Uuid
  round         Int
  requestedById String    @db.Uuid
  dueAt         DateTime  @db.Timestamptz(3)
  resolvedAt    DateTime? @db.Timestamptz(3)
  reminder7At   DateTime? @db.Timestamptz(3)
  reminder1At   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  items       CorrectionItem[]

  @@unique([applicationId, round])
  @@map("correction_request")
}

model CorrectionItem {
  id                  String             @id @default(uuid(7)) @db.Uuid
  correctionRequestId String             @db.Uuid
  kind                CorrectionItemKind
  /// Field name (FIELD) or document type (DOCUMENT).
  target              String
  comment             String
  /// Keyed hash of the field's value when the correction was requested (A12 requires a change).
  originalValueHash   String?
  resolvedAt          DateTime?          @db.Timestamptz(3)

  request CorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Cascade)

  @@map("correction_item")
}

/// Immutable once created (FR-040).
model FeeAssessment {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @unique @db.Uuid
  lines         Json
  totalCents    BigInt
  ruleSnapshot  Json
  assessedAt    DateTime @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("fee_assessment")
}

/// Written in the same transaction as the change it announces; relayed to BullMQ (ADR-0005).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  dispatchedAt  DateTime? @db.Timestamptz(3)
  attempts      Int       @default(0)

  notifications Notification[]

  @@index([dispatchedAt, createdAt])
  @@map("outbox_event")
}

// ─── Notifications (DATA_MODEL §6, FR-100–FR-102) ────────────────────────────

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  DEAD
}

model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  userId            String              @db.Uuid
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null for direct sends (codes and invitations are never written to the outbox).
  eventId           String?             @db.Uuid
  // Dispatched outbox rows are pruned after 30 days; the notification stays (FR-152).
  event             OutboxEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  channel           NotificationChannel @default(EMAIL)
  template          String
  /// Non-PII variables only (reference number, link targets, appointment time and place).
  vars              Json                @default("{}")
  mandatory         Boolean             @default(true)
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  providerMessageId String?
  /// Transport diagnostics only (codes), never addresses.
  lastError         String?
  readAt            DateTime?           @db.Timestamptz(3)
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([eventId, channel, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("notification")
}

model NotificationPreference {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional updates (submitted, payment received, withdrawn). Mandatory messages ignore this.
  emailOptional Boolean  @default(true)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@map("notification_preference")
}

// ─── Payments, refunds, receipts (DATA_MODEL §4, STATE_MACHINES §2–3) ───────

enum PaymentChannel {
  MOBILE_MONEY
  BANK
  CASH
  CARD
}

enum PaymentStatus {
  INITIATED
  PENDING_VERIFICATION
  AWAITING_SUPERVISOR
  CONFIRMED
  REJECTED
  FAILED
  REVERSED
}

enum RefundReason {
  WITHDRAWN_BEFORE_REVIEW
  DUPLICATE_PAYMENT
  OVERPAYMENT
  ABANDONED_UNPAID
}

enum RefundStatus {
  REQUESTED
  APPROVED
  DECLINED
  COMPLETED
  FAILED
}

enum SigningKeyStatus {
  ACTIVE
  RETIRED
}

/// Status changes only through PaymentStateService. Money is bigint cents.
model Payment {
  id                 String         @id @default(uuid(7)) @db.Uuid
  applicationId      String         @db.Uuid
  channel            PaymentChannel
  provider           String
  reference          String
  /// Upper-cased, whitespace-free reference used for duplicate detection (FR-052).
  referenceNorm      String
  amountCents        BigInt
  paidAt             DateTime       @db.Timestamptz(3)
  status             PaymentStatus
  idempotencyKey     String?        @unique
  payerName          String?
  evidenceDocumentId String?        @db.Uuid
  recordedById       String?        @db.Uuid
  firstConfirmedById String?        @db.Uuid
  confirmedById      String?        @db.Uuid
  confirmedAt        DateTime?      @db.Timestamptz(3)
  rejectReasonCodeId String?        @db.Uuid
  rejectNote         String?
  overpaidCents      BigInt         @default(0)
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  application Application    @relation(fields: [applicationId], references: [id])
  events      PaymentEvent[]
  refunds     Refund[]
  receipt     Receipt?

  // Partial unique index on (channel, provider, referenceNorm) for non-REJECTED rows is in the migration SQL.
  @@index([applicationId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@map("payment")
}

/// Append-only. providerEventId makes gateway webhooks idempotent.
model PaymentEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  paymentId       String         @db.Uuid
  type            String
  fromStatus      PaymentStatus?
  toStatus        PaymentStatus?
  actorId         String?        @db.Uuid
  payload         Json           @default("{}")
  providerEventId String?        @unique
  at              DateTime       @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, at])
  // Report date ranges (Phase 09: report_money_movement).
  @@index([at])
  @@map("payment_event")
}

/// Status changes only through RefundService.
model Refund {
  id               String          @id @default(uuid(7)) @db.Uuid
  paymentId        String          @db.Uuid
  reason           RefundReason
  amountCents      BigInt
  status           RefundStatus    @default(REQUESTED)
  requestedById    String?         @db.Uuid
  approvedById     String?         @db.Uuid
  payoutMethod     PaymentChannel?
  payoutReference  String?
  providerRefundId String?         @unique
  note             String?
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refund")
}

/// Issued once per CONFIRMED payment; the signed payload is immutable, so the PDF is rendered on demand.
model Receipt {
  id            String   @id @default(uuid(7)) @db.Uuid
  receiptNo     String   @unique
  paymentId     String   @unique @db.Uuid
  applicationId String   @db.Uuid
  amountCents   BigInt
  issuedAt      DateTime @db.Timestamptz(3)
  payloadJson   Json
  signature     Bytes
  keyId         String

  payment    Payment    @relation(fields: [paymentId], references: [id])
  signingKey SigningKey @relation(fields: [keyId], references: [id])

  @@index([applicationId])
  @@map("receipt")
}

/// Gap-free counters (e.g. receipt:2026), incremented atomically inside the issuing transaction.
model Counter {
  name      String @id
  nextValue BigInt

  @@map("counter")
}

/// Public halves of the Ed25519 signing keys (private keys live in the secret store only).
model SigningKey {
  id          String           @id
  algorithm   String           @default("Ed25519")
  publicKey   Bytes
  status      SigningKeyStatus
  activatedAt DateTime         @default(now()) @db.Timestamptz(3)
  retiredAt   DateTime?        @db.Timestamptz(3)

  receipts     Receipt[]
  certificates Certificate[]

  @@map("signing_key")
}

// ─── Review workflow and certificates (DATA_MODEL §3, §5; STATE_MACHINES §1, §4) ─

enum AppointmentKind {
  FINGERPRINTS
  APPEARANCE
}

enum AppointmentStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum ReviewLevel {
  OFFICER
  SUPERVISOR
}

enum ReviewDecisionKind {
  APPROVE
  FORWARD
  RETURN
  REJECT
  REFER
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum RevokeReason {
  FRAUD
  ERROR
  CHARGEBACK
  SUPERSEDED
}

model Appointment {
  id              String            @id @default(uuid(7)) @db.Uuid
  applicationId   String            @db.Uuid
  kind            AppointmentKind
  scheduledAt     DateTime          @db.Timestamptz(3)
  location        String
  status          AppointmentStatus @default(SCHEDULED)
  /// Birth registration: who appeared (names and roles).
  attendees       Json?
  scheduledById   String            @db.Uuid
  recordedById    String?           @db.Uuid
  recordedAt      DateTime?         @db.Timestamptz(3)
  rescheduleCount Int               @default(0)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status, scheduledAt])
  @@map("appointment")
}

/// Officer and supervisor decisions. A supervisor decision must not be by the officer who forwarded it (trigger).
model ReviewDecision {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @db.Uuid
  level         ReviewLevel
  decision      ReviewDecisionKind
  outcome       ReviewOutcome?
  reasonCodeId  String?            @db.Uuid
  /// Shown to the citizen (rejections, returns).
  note          String?
  /// Police "record found" details: encrypted, never shown online.
  noteEnc       Bytes?
  decidedById   String             @db.Uuid
  decidedAt     DateTime           @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, decidedAt])
  @@map("review_decision")
}

/// Status VALID|REVOKED is stored; EXPIRED is derived from expiresAt. The PDF is rendered on demand.
model Certificate {
  id               String            @id @default(uuid(7)) @db.Uuid
  certificateNo    String            @unique
  applicationId    String            @db.Uuid
  serviceId        String            @db.Uuid
  holderUserId     String            @db.Uuid
  subjectKey       String
  /// Full name of the person the certificate is about (the child for a birth certificate).
  holderName       String
  holderNameMasked String
  issuedAt         DateTime          @db.Timestamptz(3)
  expiresAt        DateTime?         @db.Timestamptz(3)
  status           CertificateStatus @default(VALID)
  revokedAt        DateTime?         @db.Timestamptz(3)
  revokedById      String?           @db.Uuid
  revokeReason     RevokeReason?
  revokeNote       String?
  duplicateOfId    String?           @db.Uuid
  supersededById   String?           @db.Uuid
  payloadJson      Json
  signature        Bytes
  keyId            String
  version          Int               @default(0)

  application Application   @relation(fields: [applicationId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  signingKey  SigningKey    @relation(fields: [keyId], references: [id])
  duplicateOf Certificate?  @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates  Certificate[] @relation("Duplicates")

  @@index([serviceId, subjectKey, status])
  @@index([holderUserId])
  @@map("certificate")
}
